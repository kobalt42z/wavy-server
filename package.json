{
  "name": "wavy-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Web playback service: probes media files and serves them to Chrome directly or as HLS via FFmpeg.",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "samples": "bun scripts/generate-samples.ts",
    "scan": "bun scripts/scan.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "hls.js": "1.7.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.15",
    "prom-client": "^15.1.3"
  }
}
